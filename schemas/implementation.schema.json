{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stage": {
      "const": "implementation"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "path",
          "requirementIds",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "mitigated",
              "accepted"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "resolution": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "description",
          "severity",
          "status",
          "owner",
          "resolution",
          "reference"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "rollback": {
      "type": "object",
      "properties": {
        "procedure": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "checkIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "minItems": 0
        }
      },
      "required": [
        "procedure",
        "checkIds"
      ],
      "additionalProperties": false
    },
    "documentationPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "summary",
    "changes",
    "risks",
    "rollback",
    "documentationPaths"
  ],
  "additionalProperties": false
}
