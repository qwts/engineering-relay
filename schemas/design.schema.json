{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stage": {
      "const": "design"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "minItems": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 2
          },
          "chosen": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "consequences": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revisitWhen": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "requirementIds",
          "options",
          "chosen",
          "rationale",
          "consequences",
          "revisitWhen"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "requirementIds",
          "description",
          "paths",
          "acceptance"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "command",
              "review"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "minItems": 1
          },
          "inputPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "reviewerRole": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "maxAgeHours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 8760
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "requirementIds",
          "inputPaths",
          "maxAgeHours"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "command"
                }
              }
            },
            "then": {
              "required": [
                "argv",
                "timeoutSeconds"
              ],
              "not": {
                "required": [
                  "reviewerRole"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "review"
                }
              }
            },
            "then": {
              "required": [
                "reviewerRole"
              ],
              "not": {
                "required": [
                  "argv"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "domainPlans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "product",
              "data",
              "security",
              "platform",
              "reliability",
              "experience",
              "quality",
              "retirement"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifactPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "checkIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "minItems": 1
          }
        },
        "required": [
          "domain",
          "summary",
          "artifactPaths",
          "checkIds"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "summary",
    "decisions",
    "tasks",
    "checks",
    "domainPlans"
  ],
  "additionalProperties": false
}
